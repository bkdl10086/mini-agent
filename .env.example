# ===== LLM API 配置 =====
# 命名规则：{PROVIDER}_API_KEY / {PROVIDER}_BASE_URL / {PROVIDER}_MODEL
# 支持任意 OpenAI SDK 兼容的 API（DeepSeek / 百炼 / OpenAI / 硅基流动等）

# Agent 推理模型（跑 agent / eval 测试集用）
AGENT_API_KEY=your_api_key_here
AGENT_BASE_URL=https://api.deepseek.com
AGENT_MODEL=deepseek-v4-flash

# Judge 评估模型（跑 eval LLM-as-Judge 用）
JUDGE_API_KEY=your_judge_api_key
JUDGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
JUDGE_MODEL=qwen-max

# ===== 快递鸟 API（可选，不配则使用模拟数据）=====
# 注册地址: https://www.kdniao.com/reg
KDNIAO_EBUSINESS_ID=your_ebusiness_id
KDNIAO_APP_KEY=your_app_key
